{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "round",
    "specRevision",
    "specHash",
    "reviewedRevision",
    "scope",
    "reviewer",
    "findings",
    "previousFindings",
    "limitations",
    "verdict",
    "sourceCoverageGaps",
    "unsupportedRequirements",
    "contradictions",
    "unresolvedQuestions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "specRevision": {
      "type": "integer",
      "minimum": 1
    },
    "specHash": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewedRevision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scope": {
      "enum": [
        "partial",
        "full"
      ]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "model",
        "reasoning"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reasoning": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "requirementIds",
          "locations",
          "problem",
          "impact",
          "requiredOutcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "preference"
            ]
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "line"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "problem": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "requiredOutcome": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "previousFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "rejected"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "verdict": {
      "enum": [
        "READY",
        "CHANGES_REQUESTED",
        "NEEDS_INPUT"
      ]
    },
    "sourceCoverageGaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "unsupportedRequirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  }
}
